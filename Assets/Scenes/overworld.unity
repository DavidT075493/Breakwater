  scaleFactor: 0.2
  biomeInfo:
  - name: Tropical Island
    description: 'A relatively safe biome rich in basic resources. Contains everything needed for basic survival.  '
    nameColor: {r: 0.22950816, g: 1, b: 0, a: 1}
    localResources: 'Wood, Palm Wood, Rock,

      Iron Ore, Coal Ore,

      Flax Flower, Red Berries,

      \yYellow Soul Shard\

'
  - name: Swamp
    description: A jagged biome made up of many small islands. The water can make traversal difficult, but food and other resources are found easily.
    nameColor: {r: 0.05237685, g: 0.5377358, b: 0, a: 1}
    localResources: "Wood, Palm Wood, Rock, \nFlax Flower, \nCoal Ore, Uranium Ore,\nSpringcap, Wild Onion,\n\\gGreen Soul Shard\\\n"
  - name: Desert
    description: 'A sprawling biome littered with cacti. Traversal is easy, and there is a fair amount of food. However, there are no trees and only a few palm trees. '
    nameColor: {r: 0.95136166, g: 1, b: 0.33490568, a: 1}
    localResources: 'Palm Wood, Rock,

      Iron Ore, Cesium Ore,

      Cactus Chunk, Prickly Pear,

      \bBlue Soul Shard\

'
  - name: Taiga
    description: A desolate biome with few natural resources. Food is difficult to come by, but healing can be found through alternative means. Be sure to have access to a heat source in case of a snowstorm.
    nameColor: {r: 0.33490568, g: 0.7484972, b: 1, a: 1}
    localResources: 'Wood, Rock, Coal Ore,

      Iron Ore, Cobalt Ore,

      Red/Green Catalyst,

      \rRed Soul Shard\

'
  - name: Volcanic Caves
    description: 'A treacherous and claustrophobic biome consisting of one large mountain and multiple cave entrances. Monsters swarm even during the day, and food is impossible to come by.  '
    nameColor: {r: 1, g: 0.43673265, b: 0, a: 1}
    localResources: "Rock, Iron Ore, \nCoal Ore, Tungsten Ore,\nBlue/Purple Catalyst\n\\pPurple Soul Shard\\\n"
